<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/wNew" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget_gold" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_add" android:tint="@color/ink_black" android:contentDescription="@string/new_note"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/new_note" android:textColor="@color/ink_black" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <ImageView android:id="@+id/wNewVoice" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:background="@drawable/bg_widget_dark_circle" android:padding="5dp" android:src="@drawable/ic_mic" android:tint="@color/gold" android:contentDescription="@string/widget_voice_note"/>
</FrameLayout>
