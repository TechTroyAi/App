<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_bright" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_elevated" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="@color/purple_bright" android:startColor="@color/purple_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
