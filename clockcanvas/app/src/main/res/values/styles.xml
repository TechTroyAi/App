<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework-only theme: the app draws its own surfaces, so it does not need
         AppCompat/Material. Purple is reserved for accents (see colors.xml). -->
    <style name="Theme.ClockCanvas" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:colorAccent">@color/purple_primary</item>
        <item name="android:colorControlActivated">@color/purple_bright</item>
        <item name="android:colorControlHighlight">@color/ripple_purple</item>
        <item name="android:colorForeground">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:editTextStyle">@style/Widget.ClockCanvas.EditText</item>
        <item name="android:seekBarStyle">@style/Widget.ClockCanvas.SeekBar</item>
        <item name="android:switchStyle">@style/Widget.ClockCanvas.Switch</item>
    </style>

    <style name="Theme.ClockCanvas.Fullscreen" parent="Theme.ClockCanvas">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Widget.ClockCanvas.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.ClockCanvas.SeekBar" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:minHeight">28dp</item>
    </style>

    <style name="Widget.ClockCanvas.Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:thumbTextPadding">10dp</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
